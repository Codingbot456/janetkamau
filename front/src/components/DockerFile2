# Use Node.js 20 LTS (Long Term Support) - Best balance of stability and compatibility
FROM node:22-alpine

# Install bash and curl for healthchecks
RUN apk add --no-cache bash curl python3 make g++

WORKDIR /usr/src/app

# Configure npm with better performance
RUN npm config set fetch-retries 20 && \
    npm config set fetch-timeout 300000 && \
    npm config set strict-ssl false && \
    npm config set registry https://registry.npmjs.org/ && \
    npm config set maxsockets 10

# Copy package files first (better layer caching)
COPY package*.json ./

# Clean install with frozen lockfile
RUN npm ci --no-audit

# Copy the rest of the application files
COPY . .

# Build Expo for web
RUN npx expo export --platform web

# Install serve to serve static files
RUN npm install -g serve@latest

EXPOSE 3000


# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:3000/ || exit 1

# Serve from 'dist' directoryy
CMD ["serve", "-s", "dist", "-l", "3000"]